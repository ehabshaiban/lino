<!-- ================= ANNOUNCEMENT ================= -->
<div class="annc" role="status">
  <div class="annc__track" id="anncTrack">
    <div class="annc__group">
      <span><i>🚚</i> شحن مجاني للطلبات فوق 149 ر.س</span>
      <span><i>🔥</i> مخبوز طازج كل صباح</span>
      <span><i>🍫</i> شوكولاتة بلجيكية فاخرة 54%</span>
      <span><i>🎁</i> تغليف هدايا مجاني للبوكسات</span>
      <span><i>⭐</i> تقييم 4.9 من أكثر من 12,000 عميل</span>
    </div>
  </div>
</div>

<!-- ================= HEADER ================= -->
<header class="site-header" id="siteHeader">
  <div class="header-top">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:1rem">
      <span class="header-top__msg">
        <svg width="15" height="15"><use href="#i-truck"/></svg>
        <span data-i18n="shipMsg">توصيل خلال 24 ساعة داخل المدينة</span>
      </span>
      <div class="ht-actions">
        <button class="ht-btn" id="langToggle" type="button">
          <span id="langLabel">EN</span>
        </button>
        <button class="ht-btn" type="button" data-action="currency">
          <span data-i18n="currency">ريال سعودي</span>
        </button>
        <button class="ht-btn" type="button" data-action="contact">
          <svg width="13" height="13"><use href="#i-phone"/></svg>
          920-000-000
        </button>
      </div>
    </div>
  </div>

  <div class="container header-main">
    <button class="icon-btn" id="menuOpen" aria-label="فتح القائمة" aria-controls="mobileMenu">
      <svg><use href="#i-menu"/></svg>
    </button>

    <a class="brand" href="#top" aria-label="كوكيز لينو — الرئيسية">
      <!-- LOGO: قابل للاستبدال من LINO_ASSETS.logo -->
      <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="29" fill="#B4552D"/>
        <circle cx="32" cy="32" r="29" fill="none" stroke="#3B2314" stroke-width="3"/>
        <circle cx="22" cy="24" r="4" fill="#3B2314"/>
        <circle cx="40" cy="20" r="3.4" fill="#3B2314"/>
        <circle cx="44" cy="36" r="4.4" fill="#3B2314"/>
        <circle cx="28" cy="42" r="3.6" fill="#3B2314"/>
        <circle cx="17" cy="36" r="2.6" fill="#3B2314"/>
        <path d="M46 47c3-2 5-4 6-6" stroke="#F2E4C8" stroke-width="2.4" stroke-linecap="round" fill="none"/>
      </svg>
      <span class="brand__name">
        <b data-i18n="brandName">كوكيز لينو</b>
        <span class="latin-logo">COOKIES LINO</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="التنقل الرئيسي">
      <ul>
        <li><a href="#top" data-i18n="navHome">الرئيسية</a></li>
        <li class="nav-item">
          <button class="nav-parent" type="button">
            <span data-i18n="navCookies">الكوكيز</span>
            <svg class="nav-caret"><use href="#i-arrow"/></svg>
          </button>
          <div class="nav-drop">
            <a href="#categories">كوكيز كلاسيك <small>الوصفة الأصلية</small></a>
            <a href="#categories">دبل شوكولاتة <small>لعشاق الكاكاو</small></a>
            <a href="#categories">كوكيز محشي <small>نوتيلا ولوتس</small></a>
            <a href="#categories">صحي وشوفان <small>بدون سكر مضاف</small></a>
          </div>
        </li>
        <li><a href="#gifts" data-i18n="navGifts">بوكسات وهدايا</a></li>
        <li><a href="#offer" data-i18n="navOffers">العروض</a></li>
        <li><a href="#story" data-i18n="navStory">قصتنا</a></li>
        <li><a href="#faq" data-i18n="navFaq">الأسئلة الشائعة</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" type="button" data-action="search" aria-label="بحث">
        <svg><use href="#i-search"/></svg>
      </button>
      <button class="icon-btn" type="button" data-action="wishlist" aria-label="المفضلة">
        <svg><use href="#i-heart"/></svg>
        <span class="count" id="wishCount"></span>
      </button>
      <button class="icon-btn" type="button" data-action="account" aria-label="الحساب">
        <svg><use href="#i-user"/></svg>
      </button>
      <button class="icon-btn" type="button" id="themeToggle" aria-label="تبديل الوضع الليلي">
        <svg class="ic-sun"><use href="#i-sun"/></svg>
      </button>
      <button class="icon-btn" type="button" data-action="cart" aria-label="السلة">
        <svg><use href="#i-bag"/></svg>
        <span class="count" id="cartCount"></span>
      </button>
    </div>
  </div>
</header>

<!-- ================= MOBILE MENU ================= -->
<div class="scrim" id="menuScrim"></div>
<aside class="m-menu" id="mobileMenu" aria-label="قائمة الجوال">
  <div class="m-menu__head">
    <span class="brand__name"><b>كوكيز لينو</b><span class="latin-logo" style="letter-spacing:.3em">COOKIES LINO</span></span>
    <button class="icon-btn" id="menuClose" aria-label="إغلاق القائمة"><svg><use href="#i-x"/></svg></button>
  </div>
  <div class="m-menu__body">
    <a class="m-link" href="#top" data-close-menu data-i18n="navHome">الرئيسية</a>
    <button class="m-link" type="button" data-msub-toggle="subCookies">
      <span data-i18n="navCookies">الكوكيز</span>
      <svg class="nav-caret" width="16" height="16"><use href="#i-arrow"/></svg>
    </button>
    <div class="m-sub" id="subCookies">
      <a href="#categories" data-close-menu>كوكيز كلاسيك</a>
      <a href="#categories" data-close-menu>دبل شوكولاتة</a>
      <a href="#categories" data-close-menu>كوكيز محشي</a>
      <a href="#categories" data-close-menu>صحي وشوفان</a>
    </div>
    <a class="m-link" href="#gifts" data-close-menu data-i18n="navGifts">بوكسات وهدايا</a>
    <a class="m-link" href="#offer" data-close-menu data-i18n="navOffers">العروض</a>
    <a class="m-link" href="#collection" data-close-menu>كولكشن لينو</a>
    <a class="m-link" href="#story" data-close-menu data-i18n="navStory">قصتنا</a>
    <a class="m-link" href="#faq" data-close-menu data-i18n="navFaq">الأسئلة الشائعة</a>
    <a class="m-link" href="#footer" data-close-menu>تواصل معنا</a>
  </div>
  <div class="m-menu__foot">
    <button class="btn btn--primary btn--block" type="button" data-action="cart" data-close-menu>
      <svg><use href="#i-bag"/></svg> <span data-i18n="openCart">افتح السلة</span>
    </button>
    <button class="btn btn--ghost btn--block" type="button" data-action="account">
      <svg><use href="#i-user"/></svg> <span data-i18n="login">تسجيل الدخول</span>
    </button>
  </div>
</aside>

<!-- ================= MAIN ================= -->
<main id="mainContent">

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <span class="chip chip--terra hero__kicker" data-i18n="heroChip">🍪 مخبوز طازج يوميًا</span>
        <h1 class="hero__title" data-i18n-html="heroTitle">كوكيز حرفي فاخر،<br>بشوكولاتة <em>حقيقية</em></h1>
        <p class="hero__lead" data-i18n="heroLead">
          في كوكيز لينو نخبز كل قطعة يدويًا كل صباح: زبدة فرنسية، شوكولاتة بلجيكية 54%،
          ووصفات صقلناها على مدى سنوات — لتصل إليك دافئة، طرية، ولا تُنسى.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="#bestSellers">
            <span data-i18n="heroCta1">تسوّق الآن</span>
            <svg><use href="#i-arrow"/></svg>
          </a>
          <a class="btn btn--ghost" href="#gifts" data-i18n="heroCta2">اكتشف البوكسات</a>
        </div>
        <div class="hero__trust">
          <span class="hero__stars" aria-hidden="true">★★★★★</span>
          <small data-i18n="heroTrust">4.9 من 5 — أكثر من 12,000 عميل سعيد</small>
        </div>
      </div>

      <div class="hero__media reveal">
        <img class="hero__img" data-lz alt="كوكيز شوكولاتة طازج من كوكيز لينو" width="900" height="780">
        <div class="hero__float" aria-hidden="true">
          <img data-lz alt="">
          <div>
            <b>دبل شوكولاتة</b>
            <small>45 ر.س</small>
          </div>
        </div>
        <div class="hero__stamp" aria-hidden="true">مخبوز<br>اليوم<br>7:00 ص</div>
      </div>
    </div>
  </section>

  <!-- VALUES MARQUEE -->
  <div class="values" aria-hidden="true">
    <div class="annc__track" id="valuesTrack">
      <div class="annc__group">
        <span><i>✦</i> زبدة فرنسية طبيعية</span>
        <span><i>✦</i> بدون مواد حافظة</span>
        <span><i>✦</i> خَبز يومي</span>
        <span><i>✦</i> شوكولاتة بلجيكية</span>
        <span><i>✦</i> تغليف هدايا فاخر</span>
        <span><i>✦</i> توصيل مبرّد</span>
      </div>
    </div>
  </div>

  <!-- CATEGORIES -->
  <section class="section" id="categories">
    <div class="container">
      <header class="section-head section-head--center reveal">
        <span class="t-kicker" data-i18n="catKicker">الأقسام</span>
        <h2 class="t-section" data-i18n="catTitle">اختر مذاقك المفضل</h2>
        <p class="section-sub" data-i18n="catSub">من الكلاسيك الذهبي إلى المحشي الفاخر — لكل مزاج كوكيز خاص به.</p>
      </header>
      <div class="cats reveal" id="catsGrid"><!-- تُبنى بواسطة LINO --></div>
    </div>
  </section>

  <!-- BEST SELLERS -->
  <section class="section" id="bestSellers" style="padding-block-start:0">
    <div class="container">
      <header class="section-head reveal" style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem">
        <div>
          <span class="t-kicker" data-i18n="bestKicker">الأكثر مبيعًا</span>
          <h2 class="t-section" data-i18n="bestTitle">يعشقها الجميع</h2>
        </div>
        <div class="lslider__nav">
          <button class="lslider__btn" type="button" data-slide="prev" data-target="bestSlider" aria-label="السابق">
            <svg style="transform:scaleX(-1)"><use href="#i-arrow"/></svg>
          </button>
          <button class="lslider__btn" type="button" data-slide="next" data-target="bestSlider" aria-label="التالي">
            <svg><use href="#i-arrow"/></svg>
          </button>
        </div>
      </header>
      <div class="lslider reveal">
        <div class="lslider__viewport" id="bestSlider"><!-- تُبنى بواسطة LINO --></div>
      </div>
      <!-- تكامل سلة: في بيئة الإنتاج استبدل الشبكة أعلاه بـ:
           <salla-products-slider source="best_selling" limit="8" includes='["images","options"]'></salla-products-slider> -->
    </div>
  </section>

  <!-- EDITORIAL COLLECTION -->
  <section class="section" id="collection" style="padding-block-start:0">
    <div class="container">
      <header class="section-head section-head--center reveal">
        <span class="t-kicker" data-i18n="collKicker">كولكشن لينو</span>
        <h2 class="t-section" data-i18n="collTitle">قِطع تستحق التجربة</h2>
        <p class="section-sub" data-i18n="collSub">تنسيقات مختارة بعناية من مخبزنا — تصفحها كما تتصفح مجلة.</p>
      </header>
      <div class="coll reveal" id="collGrid"><!-- تُبنى بواسطة LINO --></div>
    </div>
  </section>

  <!-- STORY -->
  <section class="section story" id="story">
    <div class="container story__grid">
      <div class="story__media reveal">
        <span class="story__frame" aria-hidden="true"></span>
        <img class="story__img" data-lz alt="خبز الكوكيز في مخبز كوكيز لينو" width="700" height="650">
        <div class="story__badge"><svg width="18" height="18"><use href="#i-fire"/></svg> يُخبز أمامك يوميًا</div>
      </div>
      <div class="story__copy reveal">
        <span class="t-kicker" data-i18n="storyKicker">قصتنا</span>
        <h2 class="t-section" style="margin-block:.7rem" data-i18n="storyTitle">من فرننا إلى طاولتك</h2>
        <p class="section-sub" data-i18n="storyText">
          بدأت حكاية لينو من مطبخ صغير وشغف كبير. اليوم نخبز آلاف القطع يوميًا بنفس الوصفة الأولى:
          مكونات صادقة، يدٌ صبورة، ولا اختصارات — أبدًا.
        </p>
        <ul class="story__list">
          <li><svg><use href="#i-check"/></svg><span>زبدة فرنسية طبيعية 100%<small>بدون زيوت مهدرجة أو سمن صناعي</small></span></li>
          <li><svg><use href="#i-check"/></svg><span>شوكولاتة بلجيكية فاخرة 54% كاكاو<small>قطع حقيقية تذوب في كل قضمة</small></span></li>
          <li><svg><use href="#i-check"/></svg><span>بدون مواد حافظة أو نكهات صناعية<small>صلاحيتنا قصيرة لأن مكوناتنا حقيقية</small></span></li>
          <li><svg><use href="#i-check"/></svg><span>خَبز يومي على دفعات صغيرة<small>لن يصلك إلا كوكيز اليوم — دائمًا</small></span></li>
        </ul>
        <div class="story__stats">
          <div><b>+15</b><span data-i18n="stat1">سنة خبرة في الخَبز</span></div>
          <div><b>40K</b><span data-i18n="stat2">كوكيز نخبزها شهريًا</span></div>
          <div><b>4.9★</b><span data-i18n="stat3">متوسط تقييم عملائنا</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCT TABS -->
  <section class="section" id="shop">
    <div class="container">
      <header class="section-head section-head--center reveal">
        <span class="t-kicker" data-i18n="shopKicker">المتجر</span>
        <h2 class="t-section" data-i18n="shopTitle">تسوّق حسب ذوقك</h2>
      </header>
      <div class="tabs reveal">
        <div class="tabs__bar" role="tablist" aria-label="أقسام المنتجات">
          <button class="tab-btn is-active" role="tab" aria-selected="true" data-tab="all" data-i18n="tabAll">الكل</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-tab="new" data-i18n="tabNew">وصل حديثًا</button>
